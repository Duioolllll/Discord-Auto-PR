{
  "name": "discord-ai-pr-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @hub/control-api dev",
    "dev:bot": "pnpm --filter @hub/discord-bot dev",
    "dev:worker": "pnpm --filter @hub/worker-supervisor dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "infra:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "infra:stop": "docker compose -f infra/compose.dev.yml stop",
    "db:generate": "pnpm --filter @hub/db generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/seed.ts",
    "setup:local": "node scripts/local-env.mjs",
    "runner:build": "node --import tsx scripts/build-runner.ts",
    "dev:dashboard": "pnpm --filter @hub/dashboard dev",
    "test:e2e": "playwright test",
    "runner:check": "node --conditions=development --import tsx scripts/check-runner.ts",
    "codex:login": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/codex-login.ts",
    "codex:status": "pnpm codex:login --status"
  },
  "devDependencies": {
    "@hub/db": "workspace:*",
    "@hub/contracts": "workspace:*",
    "@hub/github": "workspace:*",
    "@hub/orchestrator": "workspace:*",
    "@hub/policy": "workspace:*",
    "@hub/queue": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "@hub/agent-codex": "workspace:*",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "153.0.0",
    "@octokit/app": "16.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.4",
      "zod": "4.6.7",
      "undici@6": "6.29.1"
    }
  }
}
