# 설정 안내: docs/integration-settings.md
# 처음에는 pnpm setup:local → pnpm config:check. 외부 연동은 필요한 단계만 준비합니다.
# 기존 .env를 이 파일로 덮어쓰지 마세요. 실제 키·로그인 파일은 Git에 넣지 않습니다.

# 1. 로컬 대시보드 / API — 개발용 기본 주소. setup:local이 준비합니다.
DATABASE_URL=postgresql://hub:hub_local_only@127.0.0.1:5432/hub
TEST_DATABASE_URL=postgresql://hub:hub_local_only@127.0.0.1:5432/hub_test
REDIS_URL=redis://127.0.0.1:6379
# API 주소(기본 3001). 대시보드 주소(3000)와 구분. 다른 PC에서는 HTTPS API 주소.
CONTROL_API_URL=http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3001
# 2. 내부 비밀값 — setup:local이 각각 다른 값을 생성합니다. 외부에서 발급받지 않습니다.
# ADMIN: 대시보드 로그인. BOT: 봇→API 인증. ENROLLMENT: 워커→API 등록.
# 같은 역할의 연결 양쪽에서는 값이 같아야 합니다. Developer Portal의 Bot 토큰은 별도입니다.
# 로컬에서 실제 문자열로 읽으므로 네트워크 프록시의 치환용 placeholder로 대체하지 마세요.
ADMIN_API_TOKEN=
BOT_API_TOKEN=
WORKER_ENROLLMENT_TOKEN=
# 대시보드 cookie 암호화용. 로그인 창에 입력하는 값이 아닙니다.
DASHBOARD_SESSION_SECRET=
# 자동 생성. 개발 GitHub App의 Webhook secret에도 같은 값을 입력합니다.
GITHUB_WEBHOOK_SECRET=

# 3. Discord — pnpm discord:setup으로 숨김 입력·파일 저장·서버 선택·명령 등록.
# 파일 설정이 우선합니다. *_FILE에는 토큰 내용 대신 실제 파일의 절대 경로를 넣습니다.
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_FILE=
# General Information → Application ID. 도우미가 자동 확인·저장합니다.
DISCORD_APPLICATION_ID=
# 봇을 초대한 서버 ID. 도우미의 서버 목록에서 선택합니다.
DISCORD_GUILD_ID=
# 관리자 사용자 ID 목록(공백 없이 쉼표 구분). Control API가 읽으므로 API 재시작 필요.
DISCORD_ADMIN_USER_IDS=
# 선택: 진단 대상 사용자 ID. 역할이나 관리자 권한을 부여하는 설정이 아닙니다.
DISCORD_CHECK_USER_ID=

# 4. GitHub — pnpm config:check --scope github (병합까지: --scope merge).
# General → App ID 숫자. OAuth Client ID와 installation ID가 아닙니다.
GITHUB_APP_ID=
# 개발 App의 Private keys에서 받은 PEM 파일의 절대 경로.
GITHUB_APP_PRIVATE_KEY_FILE=
# 선택: 인라인 웹훅 secret 대신 파일을 쓸 때만 지정. 파일 내용이 우선합니다.
GITHUB_WEBHOOK_SECRET_FILE=
# 별도로 만든 병합 App의 ID와 PEM. 개발 App의 ID·파일을 재사용하지 않습니다.
GITHUB_MERGE_APP_ID=
GITHUB_MERGE_APP_PRIVATE_KEY_FILE=
# 실제 PR 생성·병합 스위치. 준비 전에는 false 유지.
GITHUB_MUTATIONS_ENABLED=false
# installation ID는 App ID 칸에 넣지 않습니다. db:seed의 SEED_* 인자로 DB에 등록합니다.

# 5. Codex 워커 — 실제 코드를 실행하는 워커 컴퓨터에서 설정합니다.
# runner:build 후 docker image inspect로 얻은 sha256: + 64자리 이미지 ID 전체.
HUB_CODEX_IMAGE=
# 선택: AppArmor 호스트에서만. 감사된 프로필을 먼저 로드(docs/runner-security.md).
HUB_CODEX_APPARMOR_PROFILE=
# 기본 chatgpt: 워커에서 pnpm codex:login. OpenAI API 키가 필요 없습니다.
HUB_CODEX_AUTH_MODE=chatgpt
# 선택: 전용 로그인 폴더의 절대 경로. 기본은 이 체크아웃의 .local/codex-auth.
HUB_CODEX_AUTH_DIR=
# 선택: 호스트의 고정 Codex CLI 실행 경로. Docker 이미지 ID와 다릅니다.
HUB_CODEX_CLI=
# API 과금 인증을 선택할 때만 사용: HUB_CODEX_AUTH_MODE=api-key. 파일 설정 우선.
# OpenAI API 키를 넣습니다. Reason API 키·GitHub 키·ChatGPT 로그인 코드는 별도입니다.
HUB_CODEX_API_KEY=
HUB_CODEX_API_KEY_FILE=
# 목적지 제한을 구성한 hub-egress-* Docker 네트워크 이름. Reason Network와 별도.
HUB_RUNNER_NETWORK=
# JSON argv 배열. 예: '["node","--test"]'. 도구·의존성은 워커 이미지에 준비합니다.
WORKER_TEST_COMMAND=
