# Development only. Run pnpm setup:local to generate independent local auth tokens.
DATABASE_URL=postgresql://hub:hub_local_only@127.0.0.1:5432/hub
TEST_DATABASE_URL=postgresql://hub:hub_local_only@127.0.0.1:5432/hub_test
REDIS_URL=redis://127.0.0.1:6379
CONTROL_API_URL=http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3001
# These are read locally; network-proxy placeholders cannot replace raw HMAC/token inputs.
ADMIN_API_TOKEN=
BOT_API_TOKEN=
WORKER_ENROLLMENT_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Run pnpm discord:setup for guided token storage, server selection and command registration.
# Optional live Discord integration. Never commit real values.
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_FILE=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=
# Optional diagnostic identity only; grants no role or admin permissions.
DISCORD_CHECK_USER_ID=
# GitHub development App and separate merge App. Prefer secret-manager mounted files.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET_FILE=
GITHUB_MERGE_APP_ID=
GITHUB_MERGE_APP_PRIVATE_KEY_FILE=
GITHUB_MUTATIONS_ENABLED=false
# Worker execution is disabled until all prerequisites and runner:check pass.
HUB_CODEX_IMAGE=
# Optional only on AppArmor hosts; load the audited profile first (docs/runner-security.md).
HUB_CODEX_APPARMOR_PROFILE=
# Default: official Codex CLI ChatGPT login. Run pnpm codex:login on a private worker.
HUB_CODEX_AUTH_MODE=chatgpt
# Optional absolute path; defaults to this checkout's .local/codex-auth.
HUB_CODEX_AUTH_DIR=
# Optional installed CLI executable, pinned to 0.163.0 for login/status.
HUB_CODEX_CLI=
# Optional API-key authentication, used only with HUB_CODEX_AUTH_MODE=api-key.
HUB_CODEX_API_KEY=
HUB_CODEX_API_KEY_FILE=
HUB_RUNNER_NETWORK=
WORKER_TEST_COMMAND=
# setup:local generates a separate local cookie encryption key.
DASHBOARD_SESSION_SECRET=
